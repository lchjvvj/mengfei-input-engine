#!/usr/bin/make -f
# auto cmake build
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_INSTALL_PREFIX=/usr

override_dh_install:
	dh_install
	# install systemd user service
	# note: dh_installsystemd does not touch units under systemd/user/,
	# user units are enabled per-user via "systemctl --user enable"
	install -Dm644 debian/gxde-input-engine.service debian/gxde-input-engine/usr/lib/systemd/user/gxde-input-engine.service
